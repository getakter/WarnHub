# Copy to .env and adjust. Secrets live ONLY here; the database stores env-var NAMES.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# XAMPP MariaDB (default root has no password)
DB_ENGINE=ewce.db.mariadb_compat
DB_NAME=ewce
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Product name shown in the UI (internal identifiers such as the EWCE_ prefix do not change)
EWCE_PRODUCT_NAME=WarnHub

# Collector identity (be polite and identifiable)
EWCE_USER_AGENT=WarnHub-Collector/1.0 (Practical Action Bangladesh early warning; contact: ops@example.org)
EWCE_MAX_BODY_CHARS=200000

# Optional OCR (install Tesseract with Bengali data first)
EWCE_ENABLE_OCR=False
EWCE_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
EWCE_OCR_LANG=ben+eng

# Optional JS rendering (pip install -r requirements-optional.txt && playwright install chromium)
EWCE_ENABLE_PLAYWRIGHT=False

# Extra plugin modules (comma separated dotted paths); custom_plugins/*.py are always loaded
EWCE_PLUGIN_MODULES=

# Verify HTTPS with the Windows certificate store (fixes gov.bd sites with incomplete chains)
EWCE_USE_SYSTEM_CERTS=True

# Worker
EWCE_WORKER_THREADS=3

# Mailbox / site credentials referenced by NAME from the UI, e.g.:
# EWCE_MAILBOX_EXAMPLE_PASSWORD=app-password-here
# EWCE_SITE_EXAMPLE_USER=...
# EWCE_SITE_EXAMPLE_PASSWORD=...
